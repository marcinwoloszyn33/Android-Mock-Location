<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:layout_height="match_parent"
    android:layout_width="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:fitsSystemWindows="true"
        android:fillViewport="true"
        android:layout_gravity="left"
        android:paddingBottom="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentTop="true"
        android:layout_alignParentStart="true">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_heading_1"
            style="@style/section_heading_textview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_field_1"
            style="@style/input_label_textview" />

        <EditText
            android:id="@+id/input_time_interval"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number|textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_heading_2"
            style="@style/section_heading_textview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_field_2"
            style="@style/input_label_textview" />

        <EditText
            android:id="@+id/input_fixed_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number|textMultiLine" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_field_3"
            style="@style/input_label_textview" />

        <CheckBox
            android:id="@+id/input_fixed_joystick_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_field_4"
            style="@style/input_label_textview" />

        <EditText
            android:id="@+id/input_fixed_joystick_increment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal|numberSigned" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_heading_3"
            style="@style/section_heading_textview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/PreferencesActivity_field_5"
            style="@style/input_label_textview" />

        <CheckBox
            android:id="@+id/input_trip_hold_destination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_heading"
            style="@style/section_heading_textview" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_follow_label"
            style="@style/input_label_textview" />

        <CheckBox
            android:id="@+id/input_follow_real_movement"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_follow_description"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_step_length_label"
            style="@style/input_label_textview" />

        <EditText
            android:id="@+id/input_step_length_meters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_watchdog_label"
            style="@style/input_label_textview" />

        <CheckBox
            android:id="@+id/input_watchdog_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_watchdog_timeout_label"
            style="@style/input_label_textview" />

        <EditText
            android:id="@+id/input_watchdog_timeout_seconds"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_keep_alive_label"
            style="@style/input_label_textview" />

        <CheckBox
            android:id="@+id/input_aggressive_keep_alive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/frmm_keep_alive_description"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/button_leak_check"
            android:layout_gravity="center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/frmm_leak_check_button" />

        <LinearLayout
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/button_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/label_button_cancel" />

            <Button
                android:layout_marginLeft="20dp"
                android:id="@+id/button_save"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="10dp"
                android:text="@string/label_button_save" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
