<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true" android:fillViewport="true"
    android:layout_height="match_parent" android:layout_width="match_parent">
    <LinearLayout android:orientation="vertical" android:fitsSystemWindows="true"
        android:fillViewport="true" android:layout_gravity="left"
        android:layout_width="match_parent" android:layout_height="match_parent">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_1" style="@style/input_label_textview" />
        <TextView android:visibility="gone" android:id="@+id/label_trip_origin"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
        <EditText android:id="@+id/input_trip_origin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text|textNoSuggestions" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_waypoints" style="@style/input_label_textview" />
        <EditText android:id="@+id/input_trip_waypoints" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minLines="3" android:maxLines="8"
            android:gravity="top|start" android:inputType="textMultiLine|textNoSuggestions"
            android:hint="@string/TripSimulationActivity_waypoints_hint" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_2" style="@style/input_label_textview" />
        <TextView android:visibility="gone" android:id="@+id/label_trip_destination"
            android:layout_width="match_parent" android:layout_height="wrap_content" android:text="" />
        <EditText android:id="@+id/input_trip_destination" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="text|textNoSuggestions" android:singleLine="true" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_path" style="@style/input_label_textview" />
        <Spinner android:id="@+id/input_trip_path_type" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:entries="@array/trip_path_type_labels" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_amplitude" style="@style/input_label_textview" />
        <EditText android:id="@+id/input_trip_path_amplitude" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="numberDecimal" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_cycles" style="@style/input_label_textview" />
        <EditText android:id="@+id/input_trip_path_cycles" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_wraps" style="@style/input_label_textview" />
        <EditText android:id="@+id/input_trip_path_wraps" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number|numberSigned" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/TripSimulationActivity_field_3" style="@style/input_label_textview" />
        <EditText android:id="@+id/input_trip_duration" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:inputType="number" />

        <LinearLayout android:layout_marginTop="10dp" android:orientation="horizontal"
            android:layout_gravity="center" android:gravity="center"
            android:layout_width="wrap_content" android:layout_height="wrap_content">
            <Button android:id="@+id/button_toggle_state" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="10dp" android:text="@string/label_button_start" />
            <Button android:visibility="gone" android:layout_marginLeft="20dp"
                android:id="@+id/button_update" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:padding="10dp" android:text="@string/label_button_update" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
